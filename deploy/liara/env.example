# Copy these into the Liara app environment. Do not commit real secrets.
WEBUI_URL=https://owu.liara.run
WEBUI_SECRET_KEY=change-me
WEBUI_NAME=دستیار
DEFAULT_LOCALE=fa-IR

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
PGVECTOR_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
VECTOR_DB=pgvector
PGVECTOR_INDEX_METHOD=ivfflat
PGVECTOR_IVFFLAT_LISTS=100
PGVECTOR_CREATE_EXTENSION=false
PGVECTOR_INITIALIZE_MAX_VECTOR_LENGTH=1024

RAG_TOP_K=10
RAG_TOP_K_RERANKER=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
ENABLE_RAG_HYBRID_SEARCH=true
RAG_HYBRID_BM25_WEIGHT=0.4
RAG_EMBEDDING_BATCH_SIZE=16
RAG_EMBEDDING_QUERY_PREFIX=query: 
RAG_EMBEDDING_CONTENT_PREFIX=passage: 
ENABLE_ASYNC_EMBEDDING=true
ENABLE_RETRIEVAL_QUERY_GENERATION=true
TASK_MODEL_EXTERNAL=

OPENAI_API_BASE_URL=
OPENAI_API_KEY=

ENABLE_COMMUNITY_SHARING=false
ENABLE_VERSION_UPDATE_CHECK=false
UVICORN_WORKERS=1
